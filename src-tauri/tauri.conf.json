{
  "$schema": "https://raw.githubusercontent.com/nicegram/nicegram-tauri/main/core/tauri-config-schema/schema.json",
  "productName": "Codeberg",
  "identifier": "org.codeberg.app",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cd frontend && trunk serve",
    "beforeBuildCommand": "cd frontend && trunk build --release"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Codeberg",
        "width": 400,
        "height": 800,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
